# =============================================================================
# EduQuest Project - .gitignore
# Jangan commit file-file berikut ke GitHub
# =============================================================================

# --- Python / Django ---
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environment
.venv/
venv/
env/
ENV/

# Django
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# --- Environment / secrets ---
.env
.env.local
.env.*.local
.env.example
!example.env

# --- IDE & Editor ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Testing & coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Logs ---
*.log
logs/

# --- OpenCode / agents (lokal) ---
.agents/

# --- Frontend (jika ada di kemudian hari) ---
node_modules/
dist/
build/
.next/
*.env

# --- Data besar (opsional, uncomment jika ingin mengecualikan dataset) ---
# data/indommlu/
# data/*.zip
# data/*.csv
# data/*.jsonl
